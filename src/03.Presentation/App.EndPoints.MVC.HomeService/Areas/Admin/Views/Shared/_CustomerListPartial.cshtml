@using App.Domain.Core.Dtos.CustomerAgg
@model CustomersPagedDto

@{
    ViewData["Title"] = "مدیریت مشتریان";
}

@if (Model != null && Model.CustomersDto.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>نام</th>
                <th>نام خانوادگی</th>
                <th>شماره موبایل</th>
                <th>ایمیل</th>
                <th>موجودی کیف پول</th>
                <th>شماره موبایل</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.CustomersDto)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.Email</td>                   
                    <td>@((user.WalletBalance ?? 0).ToString("N0"))</td>
                    <td>@user.CreatedAt</td>
                    <td>
                        <a asp-route-appUserId=@user.AppUserId asp-controller="Customers" asp-action="Update" class="btn btn-sm btn-primary">ویرایش</a>
                        <a class="btn btn-sm btn-primary">تغییر رمز</a>
                        <a class="btn btn-sm btn-primary">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">هیچ مشتری برای نمایش یافت نشد.</div>
}
