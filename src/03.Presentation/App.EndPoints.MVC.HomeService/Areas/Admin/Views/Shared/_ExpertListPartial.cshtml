
@using App.Domain.Core.Dtos.ExpertAgg
@model ExpertsPagedDto

@{
    ViewData["Title"] = "مدیریت مشتریان";
}

@if (Model != null && Model.ExpertsDto.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>نام</th>
                <th>نام خانوادگی</th>
                <th>شماره موبایل</th>
                <th>امتیاز</th>
                <th>تخصص ها</th>
                <th>تاریخ</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.ExpertsDto)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.PhoneNumber</td>
                    <td>@user.AverageScore?.ToString("F1")</td>
                    <td>@string.Join(" | ", user.HomeServicesName)</td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-controller="Experts" asp-action="Update" asp-route-appUserId="@user.AppUserId" class="btn btn-sm btn-primary">ویرایش</a>
                        <a class="btn btn-sm btn-primary">تغییر رمز</a>
                        <a class="btn btn-sm btn-primary">حذف</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">هیچ مشتری برای نمایش یافت نشد.</div>
}
